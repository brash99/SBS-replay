# Run-specific timing calibration for hydrogen run 5711.
# The detector-wide pixel, time-walk, propagation, and alignment constants stay
# fixed to the commissioned Run 5710 master.  For LH2 runs the physically
# motivated production policy fixes ECal p1 to zero; only shift_ns varies.

[ECalTiming]
p1 0.000000

[GlobalTiming]
shift_ns 3.422000
